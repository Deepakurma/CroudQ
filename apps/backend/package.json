{
  "name": "@bunkezy/backend",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/app-router.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/bun": "^1.3.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.16.0",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.39.2",
    "lint-staged": "^16.2.7",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.55.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1002.0",
    "@aws-sdk/s3-request-presigner": "^3.1002.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "@trpc/server": "^11.9.0",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.1",
    "fastify": "^5.7.4",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.18.0",
    "pino-pretty": "^13.1.3",
    "zod": "^4.3.6"
  },
  "scripts": {
    "dev": "bun run --watch src/main.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "pre-commit": "lint-staged",
    "docker:build": "docker build -t bunkezy-backend .",
    "docker:run": "docker run --rm -p 4000:4000 bunkezy-backend",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:reset": "bun --env-file=.env scripts/reset-db.ts"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix"
    ]
  }
}
