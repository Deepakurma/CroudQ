<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reset your CroudQ password</title>
    <style>
      @media only screen and (max-width: 600px) {
        .email-shell {
          padding: 20px 10px !important;
        }

        .email-hero {
          padding: 24px 20px 22px !important;
        }

        .email-section {
          padding: 22px 20px !important;
        }

        .email-section-tight {
          padding: 0 20px 16px !important;
        }

        .email-section-footer {
          padding: 0 20px 24px !important;
        }

        .email-title {
          font-size: 28px !important;
        }
      }
    </style>
  </head>
  <body style="margin:0;padding:0;background:#090B14;color:#F5F7FF;font-family:Arial,Helvetica,sans-serif;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" class="email-shell" style="background:#090B14;padding:40px 18px;">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:640px;background:#111526;border:1px solid #2A3154;border-radius:28px;overflow:hidden;">
            <tr>
              <td style="padding:0;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:linear-gradient(135deg,#161C3F 0%,#11172C 55%,#090B14 100%);">
                  <tr>
                    <td class="email-hero" style="padding:32px 36px 28px;">
                      <p style="margin:0 0 14px;font-size:13px;letter-spacing:0.12em;text-transform:uppercase;color:#9AA3C7;font-weight:700;">
                        CroudQ
                      </p>
                      <h1 class="email-title" style="margin:0 0 14px;font-size:32px;line-height:1.18;color:#FFFFFF;font-weight:700;">
                        Reset your password
                      </h1>
                      <p style="margin:0;font-size:16px;line-height:1.7;color:#C5CBE3;max-width:480px;">
                        We received a request to reset the password for <span style="color:#FFFFFF;font-weight:700;">{{email}}</span>. Use the button below to set a new password and get back into your workspace.
                      </p>
                    </td>
                  </tr>
                </table>

                <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                  <tr>
                    <td class="email-section" style="padding:36px;">
                      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#171C32;border:1px solid #2A3154;border-radius:22px;">
                        <tr>
                          <td style="padding:22px 24px;">
                            <p style="margin:0 0 18px;font-size:15px;line-height:1.7;color:#C5CBE3;">
                              This secure link will let you choose a new password for your CroudQ account.
                            </p>
                            <p style="margin:0;">
                              <a
                                href="{{resetLink}}"
                                style="display:inline-block;padding:15px 26px;border-radius:16px;background:#49A8FF;color:#090B14;font-size:15px;font-weight:700;text-decoration:none;"
                              >
                                Reset Password
                              </a>
                            </p>
                          </td>
                        </tr>
                      </table>
                    </td>
                  </tr>
                  <tr>
                    <td class="email-section-tight" style="padding:0 36px 20px;">
                      <p style="margin:0 0 12px;font-size:14px;line-height:1.6;color:#9AA3C7;">
                        If the button does not work, copy and paste this link into your browser:
                      </p>
                      <p style="margin:0;padding:18px 20px;background:#171C32;border:1px solid #2A3154;border-radius:18px;font-size:14px;line-height:1.7;color:#F5F7FF;word-break:break-word;">
                        {{resetLink}}
                      </p>
                    </td>
                  </tr>
                  <tr>
                    <td class="email-section-footer" style="padding:0 36px 36px;">
                      <p style="margin:0;font-size:13px;line-height:1.7;color:#7A84A8;">
                        This link expires in 60 minutes. If you did not request a password reset, you can safely ignore this email.
                      </p>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
          </table>
        </td>
      </tr>
      <tr>
        <td align="center" style="padding-top:18px;">
          <p style="margin:0;font-size:12px;line-height:1.6;color:#7A84A8;">
            CroudQ
          </p>
        </td>
      </tr>
    </table>
  </body>
</html>
