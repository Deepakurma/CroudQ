{
  "name": "croudq",
  "version": "1.0.0",
  "packageManager": "bun@1.3.5",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:backend": "turbo run dev --filter=@croudq/backend",
    "dev:web": "turbo run dev --filter=@croudq/web",
    "dev:croudq": "turbo run dev --filter=croudq",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@croudq/web",
    "build:backend": "turbo run build --filter=@croudq/backend",
    "typecheck": "turbo run typecheck",
    "typecheck:web": "turbo run typecheck --filter=@croudq/web",
    "typecheck:backend": "turbo run typecheck --filter=@croudq/backend",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "prepare": "husky",
    "pre-commit": "bun --filter=@croudq/backend pre-commit && bun --filter=@croudq/web pre-commit"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "turbo": "^2.8.13"
  }
}
